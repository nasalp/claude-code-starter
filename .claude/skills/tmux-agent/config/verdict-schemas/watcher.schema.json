{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/ai-rules/verdict-schemas/watcher.schema.json",
  "title": "Watcher verdict",
  "description": "Structured output a cheap watcher MUST emit per audit pass.",
  "type": "object",
  "required": ["verdict", "confidence", "reason"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject", "escalate"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "violated_rules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rule IDs / filenames the diff violates (empty on approve)."
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "required_changes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
